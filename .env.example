# ==============================================================================
# HOTEL LISTING CRUD APP - ENVIRONMENT VARIABLES
# Copy this file to .env (or .env.local) and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vite format) - Safe to expose to the browser bundle
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# The public HTTPS URL of your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The anon/public API key (used with Row Level Security for client requests)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# Backend (Node/Express) - SERVER-SIDE ONLY (NEVER expose to browser/client bundle!)
# Find this in Supabase Dashboard -> Project Settings -> API -> Project API keys
# ------------------------------------------------------------------------------
# Supabase URL for backend scripts or server
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key with full administrative bypass permissions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: PostgreSQL direct connection string (if using Express with pg)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# PORT=5000
